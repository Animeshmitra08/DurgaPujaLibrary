# Google Drive storage API that serves the catalogue (audio + Durga artwork).
# VITE_API_URL=http://localhost:5000
# VITE_API_URL=https://durgapujaapi-bd4ef.containers.snapdeploy.app
VITE_API_URL=https://durgapujaapi.onrender.com

# Must match API_KEY on the server once it is set; leave blank while auth is off.
# Anything prefixed VITE_ ends up in the browser bundle, so this is not a secret.
VITE_API_KEY=
